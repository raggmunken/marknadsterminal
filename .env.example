# Kopiera till .env och fyll i. Filen .env checkas aldrig in (se .gitignore).
# Klistra aldrig in nycklar i chattar, ärenden eller kod.

# ---------------------------------------------------------------------------
# ANVÄNDS AV KODEN I DAG
# ---------------------------------------------------------------------------

# SEC EDGAR. Ingen nyckel, men SEC kräver att ni säger vilka ni är.
# Format: namn eller bolag, sedan en riktig e-postadress.
# Behövs för: term fetch, term reverse
TERM_USER_AGENT=

# Språkmodellen som läser ut kunder och leverantörer.
# Skapas på https://console.anthropic.com
# Behövs för: term chain --extractor anthropic, term ingest --extractor anthropic
ANTHROPIC_API_KEY=
# Valfri. Standard är claude-sonnet-5-5
# TERM_LLM_MODEL=

# FRED, amerikanska räntor och makro. Gratis nyckel hos St. Louis Fed:
# https://fred.stlouisfed.org/docs/api/api_key.html
# Behövs för: term series fetch fred DGS10
FRED_API_KEY=

# OpenFIGI. Valfri. Fungerar utan nyckel men med lägre gräns.
# OPENFIGI_API_KEY=

# Databasfilen. Standard är terminal.db i mappen där kommandot körs
# TERM_DB=terminal.db

# De här källorna kräver ingen nyckel och fungerar direkt:
# USGS, GDACS, GLEIF, ECB, Riksbanken, Världsbanken, filings.xbrl.org, OFAC.

# ---------------------------------------------------------------------------
# BEHÖVS FÖR NÄSTA STEG. KODEN LÄSER DEM INTE ÄN.
# ---------------------------------------------------------------------------

# Kurshistorik med avlistade bolag (del 3). Betald. Leverantör inte vald.
# Kandidater i planen: EODHD, Norgate Data, Sharadar.
# PRICE_API_KEY=

# EIA, energi. Gratis nyckel efter registrering.
# EIA_API_KEY=

# aisstream.io, fartygspositioner (del 2). Gratis nyckel.
# AISSTREAM_API_KEY=

# EDINET (Japan) och Open DART (Sydkorea). Gratis nycklar. Först efter version 2.0.
# EDINET_API_KEY=
# DART_API_KEY=

# Analytikerestimat. Betald. Leverantör inte vald.
# ESTIMATES_API_KEY=
